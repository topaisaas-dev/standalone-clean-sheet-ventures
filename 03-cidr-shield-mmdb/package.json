{
  "name": "@topaisaas/cidr-shield-mmdb",
  "version": "1.0.1",
  "description": "Zero-latency local binary IP threat database (Datacenter, Tor, VPN, Proxies) and Radix Trie LPM engine replacing MaxMind/IPinfo with $0.00 query cost.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cidr-shield": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild bin/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "start": "node dist/cli.js",
    "test": "node --test tests/cidr_shield.test.js"
  },
  "keywords": [
    "ip-lookup",
    "radix-trie",
    "patricia-trie",
    "mmdb",
    "maxmind-alternative",
    "ipinfo-alternative",
    "fraud-prevention",
    "datacenter-ip",
    "tor-exit-node",
    "vpn-detection",
    "cidr",
    "longest-prefix-match"
  ],
  "author": "TopAI Sovereign Studio",
  "license": "Apache-2.0"
}
