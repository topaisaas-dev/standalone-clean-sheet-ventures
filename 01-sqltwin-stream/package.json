{
  "name": "@topaisaas/sqltwin-stream",
  "version": "1.0.1",
  "description": "Deterministic, streaming SQL dump anonymizer (PostgreSQL, MySQL, SQLite) preserving 100% of FOREIGN KEY joins and UNIQUE constraints with zero memory overhead.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sqltwin": "dist/cli.js",
    "sqltwin-stream": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "action.yml",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild bin/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "start": "node dist/cli.js",
    "test": "node --test tests/sqltwin.test.js"
  },
  "keywords": [
    "sql",
    "postgresql",
    "anonymizer",
    "gdpr",
    "hipaa",
    "fpe",
    "database-clone",
    "streaming",
    "ci-cd",
    "test-database",
    "foreign-keys"
  ],
  "author": "TopAI Sovereign Studio",
  "license": "Apache-2.0"
}
